# Dependencies
node_modules/

# Build output
dist/
dist-ssr/
*.local

# Netlify
.netlify/

# Environment - never commit these
.env
.env.*
!.env.example

# Resumes and other personal documents dropped in the repo root during the
# workshop. Ignored by pattern, not by exact name: a real resume carries a phone
# number and a home address, and this repo is going to be public. The placeholder
# in public/ is unaffected.
/*.pdf
/*.doc
/*.docx
/*.txt
/*.rtf
my-resume.*

# Editor / OS
.DS_Store
.vscode/*
!.vscode/extensions.json
.idea/
*.swp

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Test / tooling caches
coverage/
.eslintcache
*.tsbuildinfo

# Presenter-only. The build brief names internal repos, staff and run-of-show
# detail that should not ship in a public template. Keep it local.
WORKSHOP-BRIEF.md
