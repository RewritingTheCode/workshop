# Copy this file to .env and fill in the values. .env is gitignored - never commit it.
#
# Netlify personal access token.
# Netlify -> User settings -> Applications -> Personal access tokens -> New access token
# No quotes, no trailing space.
NETLIFY_AUTH_TOKEN=

# The site this repo deploys to.
# Get it after your first deploy with: npx netlify-cli status
NETLIFY_SITE_ID=
